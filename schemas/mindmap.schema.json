{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-library.dev/schema/mindmap.json",
  "title": "Cyber Library Mind Map Node",
  "$defs": {
    "node": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "relation": {"type": ["string", "null"]},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/node"
}
