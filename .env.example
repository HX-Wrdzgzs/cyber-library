# Identify your application to Open Library and other low-volume public sources.
CYBER_LIBRARY_CONTACT=

# Optional OpenAI-compatible chat-completions endpoint.
CYBER_LIBRARY_LLM_BASE_URL=
CYBER_LIBRARY_LLM_MODEL=
CYBER_LIBRARY_LLM_API_KEY=
CYBER_LIBRARY_LLM_TIMEOUT=90
CYBER_LIBRARY_LLM_TEMPERATURE=0.15

# Optional OpenAI-compatible embeddings endpoint for semantic / hybrid search.
CYBER_LIBRARY_EMBEDDING_BASE_URL=
CYBER_LIBRARY_EMBEDDING_MODEL=
CYBER_LIBRARY_EMBEDDING_API_KEY=
CYBER_LIBRARY_EMBEDDING_TIMEOUT=60

# Optional source endpoint overrides.
CYBER_LIBRARY_WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
CYBER_LIBRARY_CROSSREF_BASE_URL=https://api.crossref.org
CYBER_LIBRARY_LOC_LCDB_URL=http://lx2.loc.gov:210/LCDB
CYBER_LIBRARY_LOC_NAF_URL=http://lx2.loc.gov:210/NAF

# Optional PostgreSQL/PostGIS mirror.
CYBER_LIBRARY_POSTGRES_DSN=

# Optional OpenSearch index.
CYBER_LIBRARY_OPENSEARCH_URL=
CYBER_LIBRARY_OPENSEARCH_INDEX=cyber-library
CYBER_LIBRARY_OPENSEARCH_USERNAME=
CYBER_LIBRARY_OPENSEARCH_PASSWORD=
CYBER_LIBRARY_OPENSEARCH_BEARER_TOKEN=
CYBER_LIBRARY_OPENSEARCH_TIMEOUT=30

# Optional Qdrant ANN/vector backend.
CYBER_LIBRARY_QDRANT_URL=
CYBER_LIBRARY_QDRANT_COLLECTION=cyber_library
CYBER_LIBRARY_QDRANT_API_KEY=
CYBER_LIBRARY_QDRANT_TIMEOUT=30

# Optional S3-compatible static artifact publisher.
CYBER_LIBRARY_S3_BUCKET=
CYBER_LIBRARY_S3_PREFIX=
CYBER_LIBRARY_S3_ENDPOINT_URL=
CYBER_LIBRARY_S3_REGION=
