# Identify your application to Open Library and other low-volume public sources.
CYBER_LIBRARY_CONTACT=

# Optional OpenAI-compatible chat-completions endpoint.
# Example: http://127.0.0.1:8000/v1
CYBER_LIBRARY_LLM_BASE_URL=
CYBER_LIBRARY_LLM_MODEL=
CYBER_LIBRARY_LLM_API_KEY=
CYBER_LIBRARY_LLM_TIMEOUT=90
CYBER_LIBRARY_LLM_TEMPERATURE=0.15

# Optional OpenAI-compatible embeddings endpoint for semantic / hybrid search.
CYBER_LIBRARY_EMBEDDING_BASE_URL=
CYBER_LIBRARY_EMBEDDING_MODEL=
CYBER_LIBRARY_EMBEDDING_API_KEY=
CYBER_LIBRARY_EMBEDDING_TIMEOUT=60

# Optional source endpoint overrides.
CYBER_LIBRARY_WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
CYBER_LIBRARY_CROSSREF_BASE_URL=https://api.crossref.org
